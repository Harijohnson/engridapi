# Copy to .env (never commit .env). Read by django-environ in engridapi/settings/base.py.

# Settings module: engridapi.settings.dev locally, engridapi.settings.prod on PythonAnywhere.
DJANGO_SETTINGS_MODULE=engridapi.settings.dev

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# true locally, false (or unset) in production.
DJANGO_DEBUG=true

# Comma-separated. Production: <username>.pythonanywhere.com (plus any Host Vercel sends).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins, e.g. https://<username>.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# D4: SQLite. Relative paths resolve against the working directory; use an absolute path in prod,
# e.g. sqlite:////home/<username>/engrid/engridapi/db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Logging: plain locally; prod settings always log JSON.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=plain


DJANGO_DB_PASSWORD = change-me
# D17: anonymous throttle rate and the number of proxies in front of Django.
# Requests arrive via Vercel's rewrite and PythonAnywhere's front end: verify the real
# X-Forwarded-For chain in Phase 7, then set API_NUM_PROXIES (probably 2). Leave unset locally.
API_THROTTLE_ANON=240/min
# API_NUM_PROXIES=2

# D16: HTTP caching of analytics responses (seconds) and the service cache TTL.
ENGRID_HTTP_MAX_AGE_S=300
ENGRID_HTTP_S_MAXAGE_S=3600
ENGRID_CACHE_TTL_S=3600

# Evaluation window (UK delivery dates, inclusive). The code is period-agnostic.
ENGRID_EVALUATION_DATE_FROM=2026-01-01
ENGRID_EVALUATION_DATE_TO=2026-01-31

# Elexon Insights API (offline ingestion only).
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_S=60
ELEXON_CHUNK_DAYS=7
ELEXON_MAX_ATTEMPTS=5
